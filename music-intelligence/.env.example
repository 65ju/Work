# Spotify app from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
# Optional. With PKCE the secret is not required; if set, it is only ever used server-side.
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered in the Spotify dashboard.
# Spotify only accepts HTTPS or loopback addresses (http://127.0.0.1, not "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Optional: enables the AI assistant. Without it the assistant shows as "coming soon".
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Listening history (optional). Vercel's Neon integration sets DATABASE_URL automatically.
DATABASE_URL=
# Hourly recorder trigger from Upstash QStash (console.upstash.com → QStash → Signing Keys)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional daily fallback via Vercel Cron (see vercel.json)
CRON_SECRET=
